# Do not commit any of this
node_modules/
.venv*/
__pycache__/
*.pyc
.ruff_cache/
.mypy_cache/
coverage/
dist/
build/
artifacts/
cc-report.json
clean-code-report.json
# The baseline IS meant to be committed (it freezes old debt and blocks new) - do not ignore it:
# .clean-code-baseline.json

# AGENTS.md is a deliverable of this pack, not a local artifact. Many people carry
# `AGENTS.md` in a GLOBAL gitignore; a repo rule outranks it, so this negation keeps
# the file committable here. (It cost one silently-empty commit to find out.)
!AGENTS.md

# Third-party verification JARs are downloaded, not vendored (see configs/java/README.md
# and configs/architecture/demo/java/README.md for the two curl commands).
javalib/
*.jar
