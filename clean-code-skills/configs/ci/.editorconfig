# EditorConfig - the minimum layout standard, applied by EVERY editor on the team.
# Put it at the repo root. It does not replace prettier/black, but it ends 80% of the pointless arguments.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.py]
indent_size = 4
# PEP8: Python uses 4 spaces; black caps the line at 88 characters
max_line_length = 88

[*.{java,kt,kts,cs,c,cpp,go,rs}]
indent_size = 4

[*.go]
# Go always uses tabs, per gofmt - do not fight gofmt
indent_style = tab
tab_width = 4

[*.{md,mdx}]
trim_trailing_whitespace = false   # 2 trailing spaces = a hard break in Markdown
max_line_length = off

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.{sh,bash,zsh}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{ts,tsx,js,jsx}]
quote_type = single
